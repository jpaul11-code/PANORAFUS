{
  "name": "panorafus-learning-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check app.js && node --check routes/api.js && node --check services/auth.js",
    "prisma:generate": "node config/generate-prisma.js",
    "db:push": "prisma db push --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.2"
    }
  }
}
